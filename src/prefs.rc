#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

// The page is embedded by the host, which already provides the frame: the style,
// the absence of a CAPTION statement and the font are exactly what the SDK's own
// sample page uses (SDK\foobar2000\foo_sample\foo_sample.rc).  A CAPTION statement
// implies WS_CAPTION, which would draw a second frame inside the host's and shift
// every control down by the caption height -- visible but not clickable.
//
// The height is capped by what the host gives the page: it sizes the page window to
// its own area and clips anything below it, without a scrollbar, so a page that is
// too tall silently loses its lower groups.  268 dialog units keeps every group
// inside the area at 96 and 125 percent scaling; tests/ui_text_fit_test.cpp fails
// if the dialog grows past that.
//
// The texts below are the Chinese ones; the page replaces every one of them at
// start-up with the string for the selected language (src/lang.cpp).  Each control
// is therefore as wide as the wider of its two texts.
IDD_JOC_PREFS DIALOGEX 0, 0, 330, 268
STYLE DS_SETFONT | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    GROUPBOX        "输出", IDC_GROUP_OUTPUT, 7, 4, 316, 72
    CONTROL         "双耳（HRTF）", IDC_RADIO_BINAURAL, "Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 16, 15, 92, 10
    CONTROL         "扬声器布局", IDC_RADIO_SPEAKER, "Button",
                    BS_AUTORADIOBUTTON | WS_TABSTOP, 16, 28, 84, 10
    COMBOBOX        IDC_COMBO_LAYOUT, 104, 25, 110, 160,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "双耳模式", IDC_LABEL_MODE, 16, 41, 66, 10
    COMBOBOX        IDC_COMBO_MODE, 86, 38, 92, 90,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "房间尾音（秒）", IDC_LABEL_TAIL, 184, 41, 58, 10
    EDITTEXT        IDC_EDIT_TAIL, 246, 38, 40, 13, ES_AUTOHSCROLL
    LTEXT           "", IDC_LABEL_OUTPUT_STATUS, 16, 53, 300, 10
    CONTROL         "强制 24bit 输出（int24）", IDC_CHECK_INT24, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 16, 65, 156, 10
    CONTROL         "接管普通 PCM 源（ffmpeg 解码）", IDC_CHECK_PCM, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 176, 65, 140, 10

    GROUPBOX        "HRTF", IDC_GROUP_HRTF, 7, 79, 316, 92
    LTEXT           "Rosella 个性化模型", IDC_RADIO_HRTF_ROSELLA, 16, 91, 146, 10
    LTEXT           "HRTF 文件", IDC_LABEL_HRTF, 16, 106, 40, 10
    EDITTEXT        IDC_EDIT_HRTF, 58, 103, 186, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "浏览…", IDC_BROWSE_HRTF, 248, 103, 52, 13
    LTEXT           "留空时读组件目录下 HRTF\\binaural.personalized_headphone。",
                    IDC_LABEL_HRTF_HINT, 16, 121, 300, 20
    LTEXT           "", IDC_LABEL_STATUS, 16, 143, 300, 20

    GROUPBOX        "增益", IDC_GROUP_GAIN, 7, 174, 316, 42
    CONTROL         "应用增益", IDC_CHECK_GAIN, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 16, 187, 48, 10
    LTEXT           "dB", IDC_LABEL_GAIN, 68, 187, 12, 10
    EDITTEXT        IDC_EDIT_GAIN, 84, 184, 44, 13, ES_AUTOHSCROLL
    LTEXT           "", IDC_LABEL_GAIN_STATUS, 134, 187, 182, 10
    CONTROL         "Dolby Dialnorm 响度均衡（-31 dBFS）", IDC_CHECK_DIALNORM, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 16, 202, 300, 10

    GROUPBOX        "其它", IDC_GROUP_MISC, 7, 219, 316, 48
    CONTROL         "交换侧环绕与后环绕声道", IDC_CHECK_SWAP_SIDE_REAR, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 176, 232, 140, 10
    LTEXT           "界面语言", IDC_LABEL_LANGUAGE, 16, 232, 34, 10
    COMBOBOX        IDC_COMBO_LANGUAGE, 52, 229, 110, 90,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "ffmpeg.exe", IDC_LABEL_FFMPEG, 16, 252, 50, 10
    EDITTEXT        IDC_EDIT_FFMPEG, 70, 249, 176, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "浏览…", IDC_BROWSE_FFMPEG, 250, 249, 50, 13
END
